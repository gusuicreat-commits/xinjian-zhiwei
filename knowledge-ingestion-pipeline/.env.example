KIP_DATABASE_URL=postgresql://knowledge:knowledge@localhost:55432/knowledge_ingestion
# Keep Hugging Face downloads isolated inside this project.
HF_HOME=.cache/huggingface
KIP_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Optional local snapshot path; when set, it takes precedence over KIP_EMBEDDING_MODEL.
KIP_EMBEDDING_MODEL_PATH=
KIP_EMBEDDING_DEVICE=auto
KIP_EMBEDDING_BATCH_SIZE=16
KIP_EMBEDDING_DIMENSION=1024
KIP_CHUNK_SIZE=1000
KIP_CHUNK_OVERLAP=120
KIP_QUERY_TOP_K=5
KIP_PDF_OCR_MIN_CHARS_PER_PAGE=30
KIP_PDF_PRIMARY_ENGINE=pdfium
KIP_PDF_QUALITY_THRESHOLD=0.65
