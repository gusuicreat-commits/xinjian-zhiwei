# Copy this file to .env before running Docker Compose.
# These values are development placeholders only. Do not reuse them in production.
APP_ENV=development
LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

POSTGRES_DB=xinjian_zhiwei
POSTGRES_USER=xinjian_app
POSTGRES_PASSWORD=TODO_CHANGE_ME_FOR_LOCAL_DEVELOPMENT
DATABASE_URL=postgresql+psycopg://xinjian_app:TODO_CHANGE_ME_FOR_LOCAL_DEVELOPMENT@postgres:5432/xinjian_zhiwei
DEVICE_OFFLINE_AFTER_SECONDS=90

# Temporary Phase 5 reviewer API credential. Leave empty to fail closed.
# Replace this boundary with teacher accounts and role authorization in the user-model phase.
REVIEW_ACCESS_TOKEN=

# Phase 8 knowledge framework. These defaults control deterministic text chunking only.
# Embedding settings stay empty until a Provider/model and data policy are approved.
KNOWLEDGE_CHUNK_SIZE_CHARS=1200
KNOWLEDGE_CHUNK_OVERLAP_CHARS=150
KNOWLEDGE_MAX_DOCUMENT_CHARS=500000
KNOWLEDGE_EMBEDDING_PROVIDER=
KNOWLEDGE_EMBEDDING_MODEL=
KNOWLEDGE_EMBEDDING_DIMENSIONS=

# Phase 9 placeholders. The backend must remain usable when these are unset.
AI_PROVIDER=TODO[待补充]
AI_BASE_URL=
AI_MODEL=TODO[待补充]
AI_API_KEY=
