# Copy this file to .env before running Docker Compose.
# These values are development placeholders only. Do not reuse them in production.
APP_ENV=development
LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

POSTGRES_DB=xinjian_zhiwei
POSTGRES_USER=xinjian_app
POSTGRES_PASSWORD=TODO_CHANGE_ME_FOR_LOCAL_DEVELOPMENT
DATABASE_URL=postgresql+psycopg://xinjian_app:TODO_CHANGE_ME_FOR_LOCAL_DEVELOPMENT@postgres:5432/xinjian_zhiwei
DEVICE_OFFLINE_AFTER_SECONDS=90

# Temporary Phase 5 reviewer API credential. Leave empty to fail closed.
# Replace this boundary with teacher accounts and role authorization in the user-model phase.
REVIEW_ACCESS_TOKEN=

# Phase 8 knowledge framework. These defaults control deterministic text chunking only.
# Embedding settings stay empty until a Provider/model and data policy are approved.
KNOWLEDGE_CHUNK_SIZE_CHARS=1200
KNOWLEDGE_CHUNK_OVERLAP_CHARS=150
KNOWLEDGE_MAX_DOCUMENT_CHARS=500000
KNOWLEDGE_EMBEDDING_PROVIDER=
KNOWLEDGE_EMBEDDING_MODEL=
KNOWLEDGE_EMBEDDING_DIMENSIONS=
KNOWLEDGE_EMBEDDING_TRANSPORT=disabled
KNOWLEDGE_EMBEDDING_BASE_URL=
KNOWLEDGE_EMBEDDING_API_KEY=

# Phase 9 provider-independent AI framework.
# TODO[待补充]: AI/Embedding Provider, approved model, API endpoint and server-side keys.
# Keep transports disabled until those choices and the knowledge data policy are approved.
AI_TRANSPORT=disabled
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=1
AI_PROMPT_VERSION=phase9-v1
AI_REQUIRE_KNOWLEDGE=true
AI_KNOWLEDGE_LIMIT=5
AI_MAX_CONTEXT_ITEMS=50

# Phase 9 lightweight deterministic-first routing. Disabled by default.
DIAGNOSIS_EPISODE_WINDOW_SECONDS=300
AI_ENABLED=false
AI_LOCAL_ENABLED=false
AI_CLOUD_ENABLED=false
AI_LOCAL_PROVIDER=
AI_LOCAL_BASE_URL=
AI_LOCAL_MODEL=
AI_LOCAL_API_KEY=
AI_CLOUD_PROVIDER=
AI_CLOUD_BASE_URL=
AI_CLOUD_MODEL=
AI_CLOUD_API_KEY=
AI_CALLS_PER_EPISODE=2
AI_CALLS_PER_DEVICE_HOUR=4
AI_DAILY_BUDGET=
AI_INPUT_TOKEN_LIMIT=2000
AI_OUTPUT_TOKEN_LIMIT=800
AI_OUTPUT_LANGUAGE=zh-CN
AI_MAX_COST_PER_CALL=
AI_LOW_CONFIDENCE_THRESHOLD=0.65
AI_INPUT_COST_PER_1K_TOKENS=
AI_OUTPUT_COST_PER_1K_TOKENS=
AI_CACHE_TTL_SECONDS=86400
AI_SCHEMA_VERSION=phase9-light-v1
RAG_LEXICAL_TOP_N=10
RAG_VECTOR_TOP_N=10
RAG_FUSED_TOP_K=5
RAG_RRF_K=60
